<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>College Complaint Management System</display-name>

    <listener>
        <listener-class>com.college.ccms.listener.AppContextListener</listener-class>
    </listener>

    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.college.ccms.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>FlashFilter</filter-name>
        <filter-class>com.college.ccms.filter.FlashFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FlashFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.college.ccms.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/complaint</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.StudentDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <url-pattern>/student/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ComplaintFormServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.ComplaintFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintFormServlet</servlet-name>
        <url-pattern>/student/complaint/new</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditComplaintServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.EditComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditComplaintServlet</servlet-name>
        <url-pattern>/student/complaint/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyComplaintsServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.MyComplaintsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyComplaintsServlet</servlet-name>
        <url-pattern>/student/complaints</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WithdrawComplaintServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.WithdrawComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WithdrawComplaintServlet</servlet-name>
        <url-pattern>/student/complaint/withdraw</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ComplaintDetailServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.ComplaintDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintDetailServlet</servlet-name>
        <url-pattern>/complaint</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminComplaintListServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.AdminComplaintListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminComplaintListServlet</servlet-name>
        <url-pattern>/admin/complaints</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminComplaintActionServlet</servlet-name>
        <servlet-class>com.college.ccms.servlet.AdminComplaintActionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminComplaintActionServlet</servlet-name>
        <url-pattern>/admin/complaint/update</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
